
import QtQuick
import QtQuick.Layouts
import Quickshell
import Quickshell.Wayland
import Quickshell.Io

PanelWindow {
    id: root

    implicitWidth: 760
    implicitHeight: 710

    anchors {
        top: true
        left: true
        right: true
    }

    margins {
        top: 50
        left: 0
        right: 0
    }

    color: "transparent"
    exclusiveZone: 0

    WlrLayershell.namespace: "razp-dashboard"
    WlrLayershell.layer: WlrLayer.Overlay
    WlrLayershell.keyboardFocus: WlrKeyboardFocus.None

    property string panel: "#f21b1118"
    property string surface: "#30202b"
    property string borderColor: "#704052"
    property string pink: "#ffc0d2"
    property string muted: "#bd91a4"
    property string textColor: "#ffe5ed"

    property string currentTime: Qt.formatDateTime(
        new Date(), "hh:mm AP"
    )
    property string currentDate: Qt.formatDateTime(
		new Date(), "dddd, d MMMM yyyy"
	)
	property string songTitle: "Waiting for music..."
	property string songArtist: "Spotify"

    Timer {
        interval: 1000
        running: true
        repeat: true

        onTriggered: {
            root.currentTime = Qt.formatDateTime(
                new Date(), "hh:mm AP"
            )
            root.currentDate = Qt.formatDateTime(
                new Date(), "dddd, d MMMM yyyy"
            )
        }
	}

	Process {
    id: spotifyMetadata
    command: ["playerctl", "metadata", "--format", "{{title}}|{{artist}}"]

    stdout: StdioCollector {
        onStreamFinished: {
            var parts = text.trim().split("|")
            if (parts.length >= 2 && parts[0] !== "") {
                root.songTitle = parts[0]
                root.songArtist = parts.slice(1).join("|")
            }
        }
    }
}

Timer {
    interval: 2000
    running: true
    repeat: true
    onTriggered: spotifyMetadata.start()
}

Component.onCompleted: spotifyMetadata.start()

    Item {
        anchors.fill: parent

        Rectangle {
            id: dashboard

            width: 760
            height: 690

            anchors {
                top: parent.top
                horizontalCenter: parent.horizontalCenter
            }

            radius: 24
            color: root.panel
            border.width: 1
            border.color: root.borderColor
            clip: true

            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 22
                spacing: 15

                // Header
                RowLayout {
                    Layout.fillWidth: true
                    spacing: 12

                    ColumnLayout {
                        Layout.fillWidth: true
                        spacing: 4

                        Text {
                            text: "RAZP  ♡"
                            color: root.pink
                            font.pixelSize: 29
                            font.bold: true
                        }

                        Text {
                            text: "YOUR LITTLE CORNER OF THE DESKTOP"
                            color: root.muted
                            font.pixelSize: 10
                            font.letterSpacing: 1.5
                        }
                    }

                    Rectangle {
                        width: 94
                        height: 42
                        radius: 13
                        color: root.surface
                        border.color: root.borderColor

                        Text {
                            anchors.centerIn: parent
                            text: "✿  online"
                            color: root.pink
                            font.pixelSize: 12
                        }
                    }
                }

                // Clock and date
                Rectangle {
                    Layout.fillWidth: true
                    Layout.preferredHeight: 132
                    radius: 19
                    color: "#38202d"
                    border.color: "#704052"

                    RowLayout {
                        anchors.fill: parent
                        anchors.margins: 20
                        spacing: 12

                        ColumnLayout {
                            Layout.fillWidth: true
                            spacing: 5

                            Text {
                                text: root.currentTime
                                color: root.pink
                                font.pixelSize: 43
                                font.bold: true
                            }

                            Text {
                                text: root.currentDate
                                color: root.textColor
                                font.pixelSize: 13
                            }

                            Text {
                                text: "take it one little step at a time ♡"
                                color: root.muted
                                font.pixelSize: 11
                            }
                        }

                        Text {
                            text: "🌸"
                            font.pixelSize: 43
                        }
                    }
                }

                // Favourite apps
                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: 10

                    Text {
                        text: "YOUR FAVOURITES"
                        color: root.pink
                        font.pixelSize: 12
                        font.bold: true
                        font.letterSpacing: 1
                    }

                    GridLayout {
                        Layout.fillWidth: true
                        columns: 4
                        columnSpacing: 10
                        rowSpacing: 10

                        Repeater {
                            model: [
								{ label: "Terminal", icon: ">_", command: "kitty" },
								{ label: "Zen", icon: "♡", command: "flatpak run app.zen_browser.zen" },
                                { label: "Obsidian", icon: "✧", command: "obsidian" },
                                { label: "Files", icon: "", command: "Dolphin" }
                            ]

                            delegate: Rectangle {
                                id: appButton

                                required property var modelData

                                Layout.fillWidth: true
                                Layout.preferredHeight: 86
                                radius: 16
                                color: appMouse.containsMouse
                                    ? "#603047" : root.surface
                                border.color: appMouse.containsMouse
                                    ? root.pink : root.borderColor

                                Column {
                                    anchors.centerIn: parent
                                    spacing: 7

                                    Text {
                                        anchors.horizontalCenter: parent.horizontalCenter
                                        text: appButton.modelData.icon
                                        color: root.pink
                                        font.pixelSize: 24
                                    }

                                    Text {
                                        anchors.horizontalCenter: parent.horizontalCenter
                                        text: appButton.modelData.label
                                        color: root.textColor
                                        font.pixelSize: 11
                                    }
                                }

                                Process {
                                    id: appProcess
                                    command: ["sh", "-lc", appButton.modelData.command]
                                }

                                MouseArea {
                                    id: appMouse
                                    anchors.fill: parent
                                    hoverEnabled: true
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: appProcess.start()
                                }
                            }
                        }
                    }
                }

                // Music
                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: 9

                    Text {
                        text: "NOW PLAYING  ♫"
                        color: root.pink
                        font.pixelSize: 12
                        font.bold: true
                        font.letterSpacing: 1
                    }

                    Rectangle {
                        Layout.fillWidth: true
                        Layout.preferredHeight: 92
                        radius: 17
                        color: root.surface
                        border.color: root.borderColor

                        RowLayout {
                            anchors.fill: parent
                            anchors.margins: 15
                            spacing: 13

                            Rectangle {
                                width: 58
                                height: 58
                                radius: 13
                                color: "#603047"

                                Text {
                                    anchors.centerIn: parent
                                    text: "♫"
                                    color: root.pink
                                    font.pixelSize: 29
                                }
                            }

                            ColumnLayout {
                                Layout.fillWidth: true
                                spacing: 5

                                Text {
									text: root.songTitle
                                    color: root.textColor
                                    font.pixelSize: 14
                                    font.bold: true
                                }

                                Text {
									text: root.songArtist
                                    color: root.muted
                                    font.pixelSize: 11
                                }
                            }

                            Rectangle {
                                width: 43
                                height: 43
                                radius: 14
                                color: "#603047"

                                Text {
                                    anchors.centerIn: parent
                                    text: "▶"
                                    color: root.pink
                                    font.pixelSize: 17
                                }

                                MouseArea {
                                    anchors.fill: parent
                                    cursorShape: Qt.PointingHandCursor
                                    onClicked: spotifyProcess.start()
                                }
                            }

                            Process {
                                id: spotifyProcess
                                command: ["spotify"]
                            }
                        }
                    }
                }

                // System information
                ColumnLayout {
                    Layout.fillWidth: true
                    spacing: 9

                    Text {
                        text: "YOUR DESKTOP  ✿"
                        color: root.pink
                        font.pixelSize: 12
                        font.bold: true
                        font.letterSpacing: 1
                    }

                    RowLayout {
                        Layout.fillWidth: true
                        spacing: 10

                        Repeater {
                            model: [
                                { icon: "⌁", title: "NETWORK", value: "Wi-Fi" },
                                { icon: "ϟ", title: "POWER", value: "Battery" },
                                { icon: "◷", title: "SESSION", value: "Hyprland" }
                            ]

                            delegate: Rectangle {
                                required property var modelData

                                Layout.fillWidth: true
                                Layout.preferredHeight: 75
                                radius: 15
                                color: root.surface
                                border.color: root.borderColor

                                Column {
                                    anchors.centerIn: parent
                                    spacing: 5

                                    Text {
                                        anchors.horizontalCenter: parent.horizontalCenter
                                        text: modelData.icon
                                        color: root.pink
                                        font.pixelSize: 19
                                    }

                                    Text {
                                        anchors.horizontalCenter: parent.horizontalCenter
                                        text: modelData.title
                                        color: root.muted
                                        font.pixelSize: 9
                                    }

                                    Text {
                                        anchors.horizontalCenter: parent.horizontalCenter
                                        text: modelData.value
                                        color: root.textColor
                                        font.pixelSize: 11
                                    }
                                }
                            }
                        }
                    }
                }

                Item {
                    Layout.fillHeight: true
                }

                Text {
                    Layout.alignment: Qt.AlignHCenter
                    text: "made with love  ♡  RAZP"
                    color: root.muted
                    font.pixelSize: 10
                }
            }
        }
    }
}

