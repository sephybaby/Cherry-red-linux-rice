/* ═══════════════════════════════════
   CHERRY GRID
   ═══════════════════════════════════ */

* {
    background-color: transparent;
    text-color: #F5D9E2;
}

/* Main window */
window {
    background-color: #16080E;
    border: 2px;
    border-color: #8B1E3F;
    border-radius: 16px;
    padding: 18px;
}

/* Search bar */
inputbar {
    background-color: #260D16;
    border: 1px;
    border-color: #642039;
    border-radius: 10px;
    padding: 10px 14px;
    spacing: 8px;
}

prompt {
    text-color: #D94F78;
}

entry {
    text-color: #F5D9E2;
    placeholder-color: #9E6377;
}

/* ───── GRID ───── */

listview {
    columns: 4;
    lines: 4;
    flow: horizontal;
    fixed-columns: true;
    fixed-height: false;
    spacing: 10px;
    padding: 8px 0px 0px 0px;
    background-color: transparent;
}

/* ───── APP BLOCK ───── */

element {
    orientation: vertical;
    children: [element-icon, element-text];

    background-color: #260D16;
    border: 1px;
    border-color: #4B1729;
    border-radius: 12px;

    padding: 14px;
    spacing: 8px;

    horizontal-align: 0.5;
    vertical-align: 0.5;
}

/* Normal block */
element normal.normal {
    background-color: #260D16;
    text-color: #EBC5D1;
}

/* Alternate block */
element alternate.normal {
    background-color: #21101A;
    text-color: #EBC5D1;
}

/* Selected block */
element selected.normal {
    background-color: #8B1E3F;
    border-color: #C83B66;
    text-color: #FFFFFF;
}

/* ───── ICON ───── */

element-icon {
    size: 48px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
    background-color: transparent;
}

/* ───── APP NAME ───── */

element-text {
    horizontal-align: 0.5;
    vertical-align: 0.5;

    text-color: inherit;
    background-color: transparent;
}
